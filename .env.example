# ─────────────────────────────────────────────────────────────
# Smart Pillbox — environment variables
# Copy to `.env` for local dev, or set these in Railway Variables.
# See README.md → "Deploy to Railway".
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# ── Database (PostgreSQL) ──
# REQUIRED. On Railway, reference the PostgreSQL service variable:
#   ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@host:5432/pillbox

# ── Auth (REQUIRED) ──
# Server refuses to boot without these. Generate strong random strings, e.g.:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# ── MQTT broker ──
# Public HiveMQ broker — lets the deployed server and the ESP32 talk over the
# public internet from any network. (The embedded localhost broker is only
# used in local dev when this is unset.)
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883

# ── CORS (optional) ──
# Only needed if the client is hosted on a different origin than the API.
# Since the Express server also serves the built client, this can stay unset.
# CLIENT_ORIGIN=https://your-app.example.com

# ── Web Push (optional) ──
# Generate with: npx web-push generate-vapid-keys
# Without these, push notifications return 503 (everything else works).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── AI / Vision API keys (optional) ──
ELEVENLABS_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_OCR_MODEL=meta/llama-3.2-90b-vision-instruct
GROQ_API_KEY=
OPENAI_API_KEY=

# ── File uploads (optional) ──
UPLOAD_DIR=uploads
