# Server Configuration
PORT=4000
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173

# Authentication
JWT_SECRET=change-this-to-a-secure-random-string
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string

# Database (PostgreSQL; required by server/prisma/schema.prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pillbox_dev

# MQTT Configuration
# Option 1: External broker (HiveMQ, Mosquitto, etc.)
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
# Option 2: Local development (leave empty to use built-in aedes broker)
# MQTT_BROKER_URL=

# Voice Services (optional)
ELEVENLABS_API_KEY=
GROQ_API_KEY=

# Vision/AI Services (configure at least one provider for medication OCR)
# auto prefers Gemini, then OpenRouter, then Groq Qwen, NVIDIA, and OpenAI.
OCR_PROVIDER=auto
OCR_TIMEOUT_MS=60000
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_OCR_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_OCR_MODEL=google/gemini-2.5-flash
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_OCR_MODEL=meta/llama-3.2-90b-vision-instruct
OPENAI_API_KEY=
OPENAI_OCR_MODEL=gpt-4o
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_OCR_MODEL=qwen/qwen3.6-27b
