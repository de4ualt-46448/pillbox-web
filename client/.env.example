# Backend API base URL (the hosted Express server on Railway/Render).
# Set this in the Netlify dashboard as an environment variable so the built
# frontend knows where to send /api requests. Leave empty for local dev
# (Vite proxies /api to localhost:4000).
# VITE_API_URL=https://your-backend.up.railway.app

# MQTT WebSocket URL (for browser connection)
# HiveMQ public broker (WSS on HTTPS pages, WS on plain HTTP):
# VITE_MQTT_WS_URL=wss://broker.hivemq.com:8884/mqtt
# VITE_MQTT_WS_URL=ws://broker.hivemq.com:8000/mqtt

# Local dev (when server runs its own aedes broker):
# VITE_MQTT_WS_URL=ws://localhost:8888
